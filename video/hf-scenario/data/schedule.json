 "cues": [
  {
   "shot": "S01",
   "who": "阿嬤",
   "text": "蛤？雲林要停水？",
   "start": 12.7,
   "end": 15.501,
   "in": 12.64,
   "out": 15.751
  },
  {
   "shot": "S03",
   "who": "阿嬤",
   "text": "趕快跟大家講！",
   "start": 26.2,
   "end": 27.869,
   "in": 26.14,
   "out": 28.119
  },
  {
   "shot": "S04",
   "who": "爸爸",
   "text": "媽，水桶都裝滿了啦……",
   "start": 29.219,
   "end": 31.074,
   "in": 29.159,
   "out": 31.324
  },
  {
   "shot": "S04",
   "who": "阿嬤",
   "off": true,
   "text": "浴缸也放滿！",
   "start": 32.119,
   "end": 33.509,
   "in": 32.059,
   "out": 33.759
  },
  {
   "shot": "S05",
   "who": "小翔",
   "text": "又來了……這是真的嗎？",
   "start": 35.819,
   "end": 37.818,
   "in": 35.759,
   "out": 38.068
  },
  {
   "shot": "S06",
   "who": "小翔",
   "text": "有人說真的、有人說假的，到底哪個對啦？",
   "start": 43.519,
   "end": 46.711,
   "in": 43.459,
   "out": 46.961
  },
  {
   "shot": "S07",
   "who": "小翔",
   "text": "阿嬤，停水那個不要亂傳啦！",
   "start": 47.861,
   "end": 50.452,
   "in": 47.801,
   "out": 50.702
  },
  {
   "shot": "S07",
   "who": "阿嬤",
   "text": "哪有亂傳，你三姑傳的耶！你又沒證據！",
   "start": 51.002,
   "end": 56.25,
   "in": 50.942,
   "out": 56.5
  },
  {
   "shot": "F1",
   "who": "旁白",
   "text": "看不出真假，查了半天沒答案；謠言越傳越廣，家人還吵起來。",
   "start": 57.3,
   "end": 62.733,
   "in": 57.24,
   "out": 62.983
  },
  {
   "shot": "R1",
   "who": "旁白",
   "text": "如果，轉傳之前先查一下……",
   "start": 65.583,
   "end": 67.937,
   "in": 65.523,
   "out": 68.187
  },
  {
   "shot": "S08",
   "who": "阿嬤",
   "text": "小翔說的，先查一下。",
   "start": 71.987,
   "end": 74.339,
   "in": 71.927,
   "out": 74.589
  },
  {
   "shot": "S11",
   "who": "阿嬤",
   "text": "原來是假的！",
   "start": 93.689,
   "end": 95.039,
   "in": 93.629,
   "out": 95.289
  },
  {
   "shot": "S13",
   "who": "旁白",
   "text": "十秒就有答案，還附上查核來源。說得清楚、不用吵，謠言就停在這裡。",
   "start": 105.089,
   "end": 111.456,
   "in": 105.029,
   "out": 111.706
  },
  {
   "shot": "S14",
   "who": "爸爸",
   "text": "您的網購刷卡分期設定錯誤，將連續扣款 12 期……12 期？！我上禮拜才在網路上買東西！",
   "start": 112.906,
   "end": 120.152,
   "in": 112.846,
   "out": 120.402
  },
  {
   "shot": "S16",
   "who": "爸爸",
   "text": "不行，我現在就去處理！",
   "start": 126.402,
   "end": 128.137,
   "in": 126.342,
   "out": 128.387
  },
  {
   "shot": "S16",
   "who": "旁白",
   "text": "接下來，假客服就會叫他去 ATM「解除分期」……",
   "start": 128.687,
   "end": 132.644,
   "in": 128.627,
   "out": 132.894
  },
  {
   "shot": "S17",
   "who": "爸爸",
   "text": "等等……先查一下。",
   "start": 134.494,
   "end": 135.976,
   "in": 134.434,
   "out": 136.226
  },
  {
   "shot": "S19",
   "who": "爸爸",
   "text": "好險，差點就被騙了。",
   "start": 161.294,
   "end": 163.269,
   "in": 161.234,
   "out": 163.519
  },
  {
   "shot": "S19",
   "who": "旁白",
   "text": "長輩自己也會用：不用帳號、不用裝 App，還告訴你下一步該怎麼做。",
   "start": 163.819,
   "end": 169.125,
   "in": 163.759,
   "out": 169.375
  },
  {
   "shot": "S21",
   "who": "阿凱",
   "text": "吵什麼，叫機器人來。",
   "start": 178.775,
   "end": 180.693,
   "in": 178.715,
   "out": 180.943
  },
  {
   "shot": "S23",
   "who": "阿凱",
   "text": "看吧，MyGoPen 早就查過了。",
   "start": 194.975,
   "end": 197.279,
   "in": 194.915,
   "out": 197.529
  },
  {
   "shot": "S23",
   "who": "旁白",
   "text": "在討論的地方直接查，不用離開 Threads。",
   "start": 197.829,
   "end": 200.869,
   "in": 197.769,
   "out": 201.119
  },
  {
   "shot": "S24",
   "who": "阿嬤",
   "text": "有夜間公車耶！趕快跟里長群組講……",
   "start": 203.775,
   "end": 208.678,
   "in": 203.715,
   "out": 208.928
  },
  {
   "shot": "S24",
   "who": "阿嬤",
   "text": "等等，先查。",
   "start": 209.228,
   "end": 210.591,
   "in": 209.168,
   "out": 210.841
  },
  {
   "shot": "S26",
   "who": "阿嬤",
   "text": "那我等交通局公告再說。",
   "start": 231.741,
   "end": 234.463,
   "in": 231.681,
   "out": 234.713
  },
  {
   "shot": "S26",
   "who": "旁白",
   "text": "AI 不會硬掰：查不到，就說查不到。",
   "start": 235.013,
   "end": 238.022,
   "in": 234.953,
   "out": 238.272
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "用了之前，各說各話、差點被騙。",
   "start": 239.841,
   "end": 242.758,
   "in": 239.781,
   "out": 243.008
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "用了之後：貼上就查，有查核機構的結論，查不到也會老實說。",
