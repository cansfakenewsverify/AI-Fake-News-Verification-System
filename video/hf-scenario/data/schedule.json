 "cues": [
  {
   "shot": "S01",
   "who": "主持人",
   "text": "你家的群組，是不是也常收到這種訊息？",
   "in": 10.24,
   "out": 14.188
  },
  {
   "shot": "S01",
   "who": "主持人",
   "text": "真的假的，很難分。",
   "in": 14.428,
   "out": 16.713
  },
  {
   "shot": "S01",
   "who": "主持人",
   "text": "今天用三個情境，示範怎麼用全民查證公社查。",
   "in": 17.003,
   "out": 21.561
  },
  {
   "shot": "M1",
   "who": "阿嬤",
   "text": "蛤？雲林要停水？",
   "in": 25.501,
   "out": 28.612
  },
  {
   "shot": "S03",
   "who": "阿嬤",
   "text": "趕快跟大家講！",
   "in": 32.152,
   "out": 34.131
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "先暫停一下！",
   "in": 36.071,
   "out": 37.707
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "這種訊息有日期、有時間，看起來很像真的。",
   "in": 37.997,
   "out": 42.041
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "自己上網查，結果各說各話；",
   "in": 42.331,
   "out": 44.889
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "長輩又相信親戚傳的，家人還會為了真假吵架。",
   "in": 44.909,
   "out": 49.083
  },
  {
   "shot": "W1a",
   "who": "講解一",
   "text": "先長按這則訊息，按「複製」。",
   "in": 49.823,
   "out": 52.645
  },
  {
   "shot": "W1b",
   "who": "講解一",
   "text": "打開全民查證公社的網站，不用註冊，也不用下載 App。",
   "in": 53.285,
   "out": 57.934
  },
  {
   "shot": "W1c",
   "who": "講解一",
   "text": "把訊息貼上，按「開始查證」。",
   "in": 58.474,
   "out": 61.016
  },
  {
   "shot": "W1d",
   "who": "講解一",
   "text": "幾秒就有結果：紅燈，假訊息，信心高。",
   "in": 65.912,
   "out": 70.06
  },
  {
   "shot": "W1d",
   "who": "講解一",
   "text": "這則之前有人查過，所以馬上就有答案。",
   "in": 70.35,
   "out": 73.649
  },
  {
   "shot": "W1e",
   "who": "講解一",
   "text": "往下滑，查核來源是台灣事實查核中心的報告，點進去就能看原文。",
   "in": 74.289,
   "out": 80.164
  },
  {
   "shot": "W1f",
   "who": "講解一",
   "text": "最後按「複製連結」，傳回家族群組。",
   "in": 80.804,
   "out": 84.223
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "用了以後，十秒就知道真假，",
   "in": 90.363,
   "out": 92.895
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "還有查核機構的結論當根據。",
   "in": 92.915,
   "out": 95.477
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "把連結傳回群組，大家看得到來源，就不用吵了。",
   "in": 95.767,
   "out": 100.151
  },
  {
   "shot": "M3",
   "who": "爸爸",
   "text": "12 期？！我上禮拜才在網路上買東西……",
   "in": 103.891,
   "out": 107.504
  },
  {
   "shot": "M3",
   "who": "爸爸",
   "text": "我現在就打給客服！",
   "in": 107.694,
   "out": 109.57
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "先暫停一下！",
   "in": 111.51,
   "out": 113.146
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "這是很常見的「解除分期」詐騙。",
   "in": 113.436,
   "out": 116.21
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "簡訊寫得很急，要你馬上打電話；",
   "in": 116.5,
   "out": 119.239
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "接電話的假客服，會叫你去 ATM 操作，錢就被轉走了。",
   "in": 119.259,
   "out": 124.234
  },
  {
   "shot": "W2a",
   "who": "講解二",
   "text": "一樣，把整段簡訊複製，貼上，按「開始查證」。",
   "in": 124.874,
   "out": 129.126
  },
  {
   "shot": "W2b",
   "who": "講解二",
   "text": "結果是紅燈：詐騙警告，類型是網購詐騙。",
   "in": 132.662,
   "out": 136.65
  },
  {
   "shot": "W2c",
   "who": "講解二",
   "text": "判讀摘要說明，這是恐嚇式的釣魚手法。",
   "in": 137.29,
   "out": 140.989
  },
  {
   "shot": "W2d",
   "who": "講解二",
   "text": "打開「詳細說明」，它會告訴你該怎麼做：",
   "in": 141.629,
   "out": 145.015
  },
  {
   "shot": "W2d",
   "who": "講解二",
   "text": "打信用卡背面的客服電話確認，不要打簡訊裡的號碼。",
   "in": 145.035,
   "out": 149.347
  },
  {
   "shot": "W2e",
   "who": "講解二",
   "text": "下面還附上金管會、警政署的防詐資料。",
   "in": 149.987,
   "out": 153.967
  },
  {
   "shot": "S08",
   "who": "爸爸",
   "text": "好險，差點就被騙了。",
   "in": 155.738,
   "out": 158.023
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "用了以後，打電話之前就知道是詐騙，",
   "in": 159.538,
   "out": 162.789
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "也知道該打給誰。",
   "in": 162.809,
   "out": 164.359
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "長輩自己也會用：不用帳號、不用裝 App，貼上就好。",
   "in": 164.649,
   "out": 169.057
  },
  {
   "shot": "M4",
   "who": "網友",
   "text": "留言吵成這樣，到底誰說的對啦？",
   "in": 175.297,
   "out": 178.198
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "先暫停一下！",
   "in": 180.138,
   "out": 181.774
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "在社群上看到可疑貼文，想查證得先離開 App、",
   "in": 182.064,
   "out": 186.255
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "複製、再去搜尋，很多人就懶得查了。",
   "in": 186.275,
   "out": 189.397
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "留言區各說各話，謠言就一直傳下去。",
   "in": 189.687,
   "out": 193.03
  },
  {
   "shot": "W3a",
   "who": "講解三",
   "text": "只要在貼文底下留言，標記我們的查核機器人。",
   "in": 193.67,
   "out": 197.465
  },
  {
   "shot": "W3b",
   "who": "講解三",
   "text": "機器人每三十秒檢查一次，大約一分鐘內就會回覆。",
   "in": 198.105,
   "out": 202.594
  },
  {
   "shot": "W3c",
   "who": "講解三",
   "text": "回覆裡有燈號、摘要、MyGoPen 的查核來源，還有完整判讀的連結。",
   "in": 203.534,
   "out": 209.132
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "用了以後，不用離開 Threads，在討論的地方就能查，",
   "in": 209.872,
   "out": 214.232
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "留言區每個人都看得到結果。",
   "in": 214.252,
   "out": 216.296
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "目前機器人還是測試版，只回覆測試人員。",
   "in": 216.586,
   "out": 220.301
  },
  {
   "shot": "W4a",
   "who": "主持人",
   "text": "最後一種情況：看起來很正常的新聞，例如市政府說要新增夜間公車。",
   "in": 222.941,
   "out": 229.142
  },
  {
   "shot": "W4b",
   "who": "主持人",
   "text": "系統查不到能確認的資料，就會老實給黃燈「無法查證」，不會硬掰。",
   "in": 231.623,
   "out": 237.43
  },
  {
   "shot": "W4b",
   "who": "主持人",
   "text": "這時候先別轉傳，等官方公告。",
   "in": 237.72,
   "out": 240.876
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "整理一下：以前要自己搜尋、靠親戚說的，",
   "in": 241.816,
   "out": 245.665
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "遇到詐騙，還差點照著簡訊打電話。",
   "in": 245.685,
   "out": 248.954
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "現在貼上就查，有查核機構的結論；",
   "in": 249.344,
   "out": 251.921
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "在 Threads 上也能直接查，查不到也會老實說。",
   "in": 251.941,
   "out": 256.172
  },
  {
   "shot": "S13",
   "who": "主持人",
   "text": "轉傳之前，先查一下！",
   "in": 257.112,
   "out": 259.547
  }
 ]
