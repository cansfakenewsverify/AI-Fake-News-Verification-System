 "cues": [
  {
   "shot": "S01",
   "who": "主持人",
   "text": "你家的群組，是不是也常收到這種訊息？",
   "in": 10.24,
   "out": 14.188
  },
  {
   "shot": "S01",
   "who": "主持人",
   "text": "真的假的，很難分。",
   "in": 14.428,
   "out": 16.713
  },
  {
   "shot": "S01",
   "who": "主持人",
   "text": "今天用三個情境，示範怎麼用全民查證公社查。",
   "in": 17.003,
   "out": 21.561
  },
  {
   "shot": "M1",
   "who": "阿嬤",
   "text": "蛤？雲林要停水？",
   "in": 25.501,
   "out": 28.612
  },
  {
   "shot": "S03",
   "who": "阿嬤",
   "text": "趕快跟大家講！",
   "in": 32.152,
   "out": 34.131
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "這種訊息有日期、有時間，看起來很像真的。",
   "in": 36.171,
   "out": 40.215
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "自己上網查，結果各說各話；",
   "in": 40.505,
   "out": 43.063
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "長輩又相信親戚傳的，家人還會為了真假吵架。",
   "in": 43.083,
   "out": 47.257
  },
  {
   "shot": "W1a",
   "who": "講解一",
   "text": "先長按這則訊息，按「複製」。",
   "in": 47.997,
   "out": 50.819
  },
  {
   "shot": "W1b",
   "who": "講解一",
   "text": "打開全民查證公社的網站，不用註冊，也不用下載 App。",
   "in": 51.459,
   "out": 56.108
  },
  {
   "shot": "W1c",
   "who": "講解一",
   "text": "把訊息貼上，按「開始查證」。",
   "in": 56.648,
   "out": 59.19
  },
  {
   "shot": "W1d",
   "who": "講解一",
   "text": "幾秒就有結果：紅燈，假訊息，信心高。",
   "in": 64.086,
   "out": 68.234
  },
  {
   "shot": "W1d",
   "who": "講解一",
   "text": "這則之前有人查過，所以馬上就有答案。",
   "in": 68.524,
   "out": 71.823
  },
  {
   "shot": "W1e",
   "who": "講解一",
   "text": "往下滑，查核來源是台灣事實查核中心的報告，點進去就能看原文。",
   "in": 72.463,
   "out": 78.338
  },
  {
   "shot": "W1f",
   "who": "講解一",
   "text": "最後按「複製連結」，傳回家族群組。",
   "in": 78.978,
   "out": 82.397
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "用了以後，十秒就知道真假，",
   "in": 88.537,
   "out": 91.069
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "還有查核機構的結論當根據。",
   "in": 91.089,
   "out": 93.651
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "把連結傳回群組，大家看得到來源，就不用吵了。",
   "in": 93.941,
   "out": 98.325
  },
  {
   "shot": "M3",
   "who": "爸爸",
   "text": "12 期？！我上禮拜才在網路上買東西……",
   "in": 102.065,
   "out": 105.678
  },
  {
   "shot": "M3",
   "who": "爸爸",
   "text": "我現在就打給客服！",
   "in": 105.868,
   "out": 107.744
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "這是很常見的「解除分期」詐騙。",
   "in": 109.784,
   "out": 112.558
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "簡訊寫得很急，要你馬上打電話；",
   "in": 112.848,
   "out": 115.587
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "接電話的假客服，會叫你去 ATM 操作，錢就被轉走了。",
   "in": 115.607,
   "out": 120.582
  },
  {
   "shot": "W2a",
   "who": "講解二",
   "text": "一樣，把整段簡訊複製，貼上，按「開始查證」。",
   "in": 121.222,
   "out": 125.474
  },
  {
   "shot": "W2b",
   "who": "講解二",
   "text": "結果是紅燈：詐騙警告，類型是網購詐騙。",
   "in": 129.01,
   "out": 132.998
  },
  {
   "shot": "W2c",
   "who": "講解二",
   "text": "判讀摘要說明，這是恐嚇式的釣魚手法。",
   "in": 133.638,
   "out": 137.337
  },
  {
   "shot": "W2d",
   "who": "講解二",
   "text": "打開「詳細說明」，它會告訴你該怎麼做：",
   "in": 137.977,
   "out": 141.363
  },
  {
   "shot": "W2d",
   "who": "講解二",
   "text": "打信用卡背面的客服電話確認，不要打簡訊裡的號碼。",
   "in": 141.383,
   "out": 145.695
  },
  {
   "shot": "W2e",
   "who": "講解二",
   "text": "下面還附上金管會、警政署的防詐資料。",
   "in": 146.335,
   "out": 150.315
  },
  {
   "shot": "S08",
   "who": "爸爸",
   "text": "好險，差點就被騙了。",
   "in": 152.086,
   "out": 154.371
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "用了以後，打電話之前就知道是詐騙，",
   "in": 155.886,
   "out": 159.137
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "也知道該打給誰。",
   "in": 159.157,
   "out": 160.707
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "長輩自己也會用：不用帳號、不用裝 App，貼上就好。",
   "in": 160.997,
   "out": 165.405
  },
  {
   "shot": "M4",
   "who": "網友",
   "text": "留言吵成這樣，到底誰說的對啦？",
   "in": 171.645,
   "out": 174.546
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "在社群上看到可疑貼文，想查證得先離開 App、",
   "in": 176.586,
   "out": 180.777
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "複製、再去搜尋，很多人就懶得查了。",
   "in": 180.797,
   "out": 183.919
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "留言區各說各話，謠言就一直傳下去。",
   "in": 184.209,
   "out": 187.552
  },
  {
   "shot": "W3a",
   "who": "講解三",
   "text": "只要在貼文底下留言，標記我們的查核機器人。",
   "in": 188.192,
   "out": 191.987
  },
  {
   "shot": "W3b",
   "who": "講解三",
   "text": "機器人每三十秒檢查一次，大約一分鐘內就會回覆。",
   "in": 192.627,
   "out": 197.116
  },
  {
   "shot": "W3c",
   "who": "講解三",
   "text": "回覆裡有燈號、摘要、MyGoPen 的查核來源，還有完整判讀的連結。",
   "in": 198.056,
   "out": 203.654
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "用了以後，不用離開 Threads，在討論的地方就能查，",
   "in": 204.394,
   "out": 208.754
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "留言區每個人都看得到結果。",
   "in": 208.774,
   "out": 210.818
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "目前機器人還是測試版，只回覆測試人員。",
   "in": 211.108,
   "out": 214.823
  },
  {
   "shot": "W4a",
   "who": "主持人",
   "text": "最後一種情況：看起來很正常的新聞，例如市政府說要新增夜間公車。",
   "in": 217.463,
   "out": 223.664
  },
  {
   "shot": "W4b",
   "who": "主持人",
   "text": "系統查不到能確認的資料，就會老實給黃燈「無法查證」，不會硬掰。",
   "in": 226.145,
   "out": 231.952
  },
  {
   "shot": "W4b",
   "who": "主持人",
   "text": "這時候先別轉傳，等官方公告。",
   "in": 232.242,
   "out": 235.398
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "整理一下：以前要自己搜尋、靠親戚說的，",
   "in": 236.338,
   "out": 240.187
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "遇到詐騙，還差點照著簡訊打電話。",
   "in": 240.207,
   "out": 243.476
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "現在貼上就查，有查核機構的結論；",
   "in": 243.866,
   "out": 246.443
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "在 Threads 上也能直接查，查不到也會老實說。",
   "in": 246.463,
   "out": 250.694
  },
  {
   "shot": "S13",
   "who": "主持人",
   "text": "轉傳之前，先查一下！",
   "in": 251.634,
   "out": 254.069
  }
 ]
}
