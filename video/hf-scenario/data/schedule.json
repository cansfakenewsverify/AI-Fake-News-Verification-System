 "cues": [
  {
   "shot": "S02",
   "who": "A",
   "text": "欸你看，家族群組說冷水煮蛋，",
   "in": 13.04,
   "out": 14.887
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "營養會流失百分之四十，是真的嗎？",
   "in": 14.907,
   "out": 17.05
  },
  {
   "shot": "S02",
   "who": "B",
   "text": "不會吧，我家一直都冷水下鍋欸。",
   "in": 17.34,
   "out": 19.9
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "那我轉給我爸媽，叫他們以後等水滾再放蛋？",
   "in": 20.34,
   "out": 24.05
  },
  {
   "shot": "S02",
   "who": "B",
   "text": "等一下，先查一下再轉。",
   "in": 24.14,
   "out": 26.5
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "生活小知識最容易被轉，因為聽起來都很有道理，",
   "in": 28.64,
   "out": 33.034
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "還有「硫化亞鐵」這種專有名詞，更像真的。",
   "in": 33.054,
   "out": 37.077
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "自己上網查，各說各話；",
   "in": 37.367,
   "out": 39.591
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "長輩又相信家人傳的，一轉就是整個群組。",
   "in": 39.611,
   "out": 43.496
  },
  {
   "shot": "W1a",
   "who": "旁白",
   "text": "先長按這則訊息，按「複製」。",
   "in": 44.236,
   "out": 47.288
  },
  {
   "shot": "W1b",
   "who": "旁白",
   "text": "打開全民查證公社的網站，不用註冊，也不用下載 App。",
   "in": 47.928,
   "out": 53.48
  },
  {
   "shot": "W1c",
   "who": "旁白",
   "text": "把訊息貼上，按「開始查證」。",
   "in": 54.02,
   "out": 57.072
  },
  {
   "shot": "W1d",
   "who": "旁白",
   "text": "幾秒就有結果：紅燈，假訊息。",
   "in": 57.712,
   "out": 60.764
  },
  {
   "shot": "W1e",
   "who": "旁白",
   "text": "判讀摘要用白話說明這則訊息哪裡不對。",
   "in": 61.404,
   "out": 65.226
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "往下滑，有台灣事實查核中心的報告：",
   "in": 65.866,
   "out": 69.28
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "只要蛋殼沒破，用冷水煮蛋營養不會流失。",
   "in": 69.3,
   "out": 73.149
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "下面的「相似查證」還列出內容很像、已經查過的說法，",
   "in": 73.439,
   "out": 78.477
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "讓你知道判斷的根據。",
   "in": 78.497,
   "out": 80.53
  },
  {
   "shot": "W1g",
   "who": "旁白",
   "text": "最後按「複製連結」，傳回家族群組。",
   "in": 81.17,
   "out": 84.799
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "用了以後，十秒就知道真假，",
   "in": 85.539,
   "out": 88.176
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "還有查核中心的報告說明哪裡不對。",
   "in": 88.196,
   "out": 91.476
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "把連結傳回群組，大家看得到來源，就不會再轉了。",
   "in": 91.766,
   "out": 96.549
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "查到了嗎？是真的嗎？",
   "in": 97.289,
   "out": 98.549
  },
  {
   "shot": "S03",
   "who": "B",
   "text": "是錯的啦，蛋殼沒破，營養就不會流失，",
   "in": 98.789,
   "out": 101.677
  },
  {
   "shot": "S03",
   "who": "B",
   "text": "查核中心有報告。",
   "in": 101.697,
   "out": 102.999
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "冷水煮蛋沒問題喔，查核中心有說，",
   "in": 103.389,
   "out": 106.499
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "連結給你們看。",
   "in": 106.519,
   "out": 107.899
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "欸你看，巴黎超市被洗劫，唯獨豬肉沒人搶，",
   "in": 110.839,
   "out": 113.143
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "七十幾萬人看過欸，是真的嗎？",
   "in": 113.163,
   "out": 114.799
  },
  {
   "shot": "S10",
   "who": "B",
   "text": "這張圖怪怪的……留言怎麼說？",
   "in": 116.189,
   "out": 118.799
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "吵成一團，有人說是真的，有人說是假的。",
   "in": 120.089,
   "out": 122.599
  },
  {
   "shot": "S10",
   "who": "B",
   "text": "先別吵，查一下再說。",
   "in": 123.289,
   "out": 124.949
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "在社群上，一張 AI 做的圖配一句話，幾天就七十幾萬人看過。",
   "in": 127.189,
   "out": 133.318
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "想查證得先離開 App、複製、再去搜尋，很多人就懶得查了；",
   "in": 133.608,
   "out": 139.385
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "留言區各說各話，說法就一直傳下去。",
   "in": 139.405,
   "out": 142.814
  },
  {
   "shot": "W2a",
   "who": "旁白",
   "text": "只要在貼文底下留言，標記我們的查核機器人。",
   "in": 143.454,
   "out": 147.852
  },
  {
   "shot": "W2b",
   "who": "旁白",
   "text": "機器人每三十秒檢查一次，大約一分鐘內就會回覆。",
   "in": 148.492,
   "out": 153.275
  },
  {
   "shot": "W2c",
   "who": "旁白",
   "text": "回覆裡有燈號、摘要、查核中心的報告，還有完整判讀的連結。",
   "in": 154.215,
   "out": 159.96
  },
  {
   "shot": "W2d",
   "who": "旁白",
   "text": "點開連結，就是網站上完整的判讀結果，查核來源一樣看得到，也可以再分享給別人。",
   "in": 160.6,
   "out": 168.268
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "用了以後，不用離開 Threads，在討論的地方就能查，",
   "in": 169.008,
   "out": 174.612
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "留言區每個人都看得到結果。",
   "in": 174.632,
   "out": 177.253
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "目前機器人還是測試版，只回覆測試人員。",
   "in": 177.543,
   "out": 181.557
  },
  {
   "shot": "S10b",
   "who": "B",
   "text": "機器人回了沒？",
   "in": 182.247,
   "out": 183.407
  },
  {
   "shot": "S10b",
   "who": "A",
   "text": "回了，說是 AI 做的圖，",
   "in": 183.997,
   "out": 186.035
  },
  {
   "shot": "S10b",
   "who": "A",
   "text": "還附了查核中心的報告。",
   "in": 186.055,
   "out": 187.807
  },
  {
   "shot": "S10b",
   "who": "B",
   "text": "那我轉給大家看。",
   "in": 188.197,
   "out": 189.207
  },
  {
   "shot": "W4a",
   "who": "旁白",
   "text": "最後一種情況：看起來很正常的新聞，例如市政府說要新增夜間公車。",
   "in": 192.097,
   "out": 198.419
  },
  {
   "shot": "W4b",
   "who": "旁白",
   "text": "系統查不到能確認的資料，就會老實給黃燈「無法查證」，不會硬掰。",
   "in": 199.059,
   "out": 205.381
  },
  {
   "shot": "W4b",
   "who": "旁白",
   "text": "這時候先別轉傳，等官方公告。",
   "in": 205.671,
   "out": 208.723
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "整理一下：訊息和網址貼上就查，",
   "in": 209.663,
   "out": 212.678
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "在 Threads 上標記機器人也能查；",
   "in": 212.698,
   "out": 216.754
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "每個結果都附根據，查不到也會老實說。",
   "in": 217.044,
   "out": 220.866
  },
  {
   "shot": "S13",
   "who": "旁白",
   "text": "轉傳之前，先查一下！",
   "in": 221.806,
   "out": 224.089
  }
