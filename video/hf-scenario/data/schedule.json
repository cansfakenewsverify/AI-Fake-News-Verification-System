 "cues": [
  {
   "shot": "S02",
   "who": "A",
   "text": "欸，你看，網路上說冷水煮蛋，",
   "in": 6.24,
   "out": 8.151
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "營養會流失 40%，是真的嗎？",
   "in": 8.171,
   "out": 10.25
  },
  {
   "shot": "S02",
   "who": "B",
   "text": "真的假的，我家一直都是用冷水煮的。",
   "in": 10.54,
   "out": 13.1
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "真的喔，那我傳給我爸媽，",
   "in": 13.54,
   "out": 15.37
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "叫他們以後等水滾再放蛋。",
   "in": 15.39,
   "out": 17.25
  },
  {
   "shot": "S02",
   "who": "B",
   "text": "欸，等一下，我先查一下再傳好了。",
   "in": 17.34,
   "out": 19.7
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "生活小知識最容易被轉，因為聽起來都很有道理，",
   "in": 21.84,
   "out": 25.801
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "還有「硫化亞鐵」這種專有名詞，更像真的。",
   "in": 25.821,
   "out": 29.45
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "自己上網查，各說各話；",
   "in": 29.74,
   "out": 32.026
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "長輩又相信家人傳的，一轉就是整個群組。",
   "in": 32.046,
   "out": 36.04
  },
  {
   "shot": "W1a",
   "who": "旁白",
   "text": "先長按這則訊息，按「複製」。",
   "in": 36.78,
   "out": 39.602
  },
  {
   "shot": "W1b",
   "who": "旁白",
   "text": "打開全民查證公社的網站，不用註冊，也不用下載 App。",
   "in": 40.242,
   "out": 44.891
  },
  {
   "shot": "W1c",
   "who": "旁白",
   "text": "把訊息貼上，按「開始查證」。",
   "in": 45.431,
   "out": 47.973
  },
  {
   "shot": "W1d",
   "who": "旁白",
   "text": "幾秒就有結果：紅燈，假訊息。",
   "in": 48.613,
   "out": 52.152
  },
  {
   "shot": "W1e",
   "who": "旁白",
   "text": "判讀摘要用白話說明這則訊息哪裡不對。",
   "in": 52.792,
   "out": 56.704
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "往下滑，有台灣事實查核中心的報告：",
   "in": 57.344,
   "out": 60.894
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "只要蛋殼沒破，用冷水煮蛋營養不會流失。",
   "in": 60.914,
   "out": 64.914
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "下面的「相似查證」還列出內容很像、已經查過的說法，",
   "in": 65.204,
   "out": 69.548
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "讓你知道判斷的根據。",
   "in": 69.568,
   "out": 71.323
  },
  {
   "shot": "W1g",
   "who": "旁白",
   "text": "最後按「複製連結」，傳回家族群組。",
   "in": 71.963,
   "out": 75.382
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "用了以後，十秒就知道真假，",
   "in": 76.122,
   "out": 78.659
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "還有查核中心的報告說明哪裡不對。",
   "in": 78.679,
   "out": 81.836
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "把連結傳回群組，大家看得到來源，就不會再轉了。",
   "in": 82.126,
   "out": 86.731
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "查到了嗎？是真的嗎？",
   "in": 87.471,
   "out": 88.731
  },
  {
   "shot": "S03",
   "who": "B",
   "text": "是假的啦，蛋殼沒破，營養就不會流失，",
   "in": 88.971,
   "out": 91.751
  },
  {
   "shot": "S03",
   "who": "B",
   "text": "查核中心都有報告。",
   "in": 91.771,
   "out": 93.181
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "喔，冷水煮蛋沒問題，查核中心有說，",
   "in": 93.571,
   "out": 96.739
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "連結給你們看。",
   "in": 96.759,
   "out": 98.082
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "欸你看，巴黎超市被洗劫，",
   "in": 101.021,
   "out": 103.156
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "只有豬肉沒有人搶耶。",
   "in": 103.176,
   "out": 104.981
  },
  {
   "shot": "S10",
   "who": "B",
   "text": "這張圖怪怪的……留言怎麼說？",
   "in": 106.371,
   "out": 108.981
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "吵成一團，有人說是真的，有人說是假的。",
   "in": 110.271,
   "out": 112.781
  },
  {
   "shot": "S10",
   "who": "B",
   "text": "先別吵，查一下再說。",
   "in": 113.471,
   "out": 115.131
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "在社群上，一張 AI 做的圖配一句話，幾天就七十幾萬人看過。",
   "in": 117.371,
   "out": 123.07
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "想查證得先離開 App、複製、再去搜尋，很多人就懶得查了；",
   "in": 123.36,
   "out": 128.561
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "留言區各說各話，說法就一直傳下去。",
   "in": 128.581,
   "out": 131.651
  },
  {
   "shot": "W2a",
   "who": "旁白",
   "text": "只要在貼文底下留言，標記我們的查核機器人。",
   "in": 132.291,
   "out": 136.086
  },
  {
   "shot": "W2b",
   "who": "旁白",
   "text": "機器人每三十秒檢查一次，大約一分鐘內就會回覆。",
   "in": 136.726,
   "out": 141.215
  },
  {
   "shot": "W2c",
   "who": "旁白",
   "text": "回覆裡有燈號、摘要、查核中心的報告，還有完整判讀的連結。",
   "in": 142.155,
   "out": 147.89
  },
  {
   "shot": "W2d",
   "who": "旁白",
   "text": "點開連結，就是網站上完整的判讀結果，查核來源一樣看得到，也可以再分享給別人。",
   "in": 148.53,
   "out": 155.711
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "用了以後，不用離開 Threads，在討論的地方就能查，",
   "in": 156.451,
   "out": 160.811
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "留言區每個人都看得到結果。",
   "in": 160.831,
   "out": 162.875
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "目前機器人還是測試版，只回覆測試人員。",
   "in": 163.165,
   "out": 166.88
  },
  {
   "shot": "S10b",
   "who": "B",
   "text": "欸，機器人回了沒有？",
   "in": 167.57,
   "out": 168.73
  },
  {
   "shot": "S10b",
   "who": "A",
   "text": "回了，說是 AI 做的圖，",
   "in": 169.32,
   "out": 171.358
  },
  {
   "shot": "S10b",
   "who": "A",
   "text": "還附了查核中心的報告。",
   "in": 171.378,
   "out": 173.13
  },
  {
   "shot": "S10b",
   "who": "B",
   "text": "那我傳給大家看。",
   "in": 173.52,
   "out": 174.53
  },
  {
   "shot": "W4a",
   "who": "旁白",
   "text": "最後一種情況：看起來很正常的新聞，例如市政府說要新增夜間公車。",
   "in": 177.42,
   "out": 183.431
  },
  {
   "shot": "W4b",
   "who": "旁白",
   "text": "系統查不到能確認的資料，就會老實給黃燈「無法查證」，不會硬掰。",
   "in": 184.071,
   "out": 189.629
  },
  {
   "shot": "W4b",
   "who": "旁白",
   "text": "這時候先別轉傳，等官方公告。",
   "in": 189.919,
