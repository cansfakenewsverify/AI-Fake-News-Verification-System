 "cues": [
  {
   "shot": "S01",
   "who": "主持人",
   "text": "你家的群組，是不是也常收到這種訊息？",
   "in": 9.24,
   "out": 13.188
  },
  {
   "shot": "S01",
   "who": "主持人",
   "text": "真的假的，很難分。",
   "in": 13.428,
   "out": 15.713
  },
  {
   "shot": "S01",
   "who": "主持人",
   "text": "今天用三個情境，示範怎麼用全民查證公社查。",
   "in": 16.003,
   "out": 20.561
  },
  {
   "shot": "S02",
   "who": "阿嬤",
   "text": "蛤？雲林要停水？",
   "in": 24.401,
   "out": 27.512
  },
  {
   "shot": "S03",
   "who": "阿嬤",
   "text": "趕快跟大家講！",
   "in": 35.652,
   "out": 37.631
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "先暫停一下！",
   "in": 39.571,
   "out": 41.135
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "這種訊息有日期、有時間，看起來很像真的。",
   "in": 41.425,
   "out": 45.809
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "自己上網查，結果各說各話；",
   "in": 46.099,
   "out": 48.763
  },
  {
   "shot": "S04",
   "who": "講解一",
   "text": "長輩又相信親戚傳的，家人還會為了真假吵架。",
   "in": 48.783,
   "out": 53.128
  },
  {
   "shot": "W1a",
   "who": "講解一",
   "text": "先長按這則訊息，按「複製」。",
   "in": 53.868,
   "out": 56.778
  },
  {
   "shot": "W1b",
   "who": "講解一",
   "text": "打開全民查證公社的網站，不用註冊，也不用下載 App。",
   "in": 57.418,
   "out": 62.239
  },
  {
   "shot": "W1c",
   "who": "講解一",
   "text": "把訊息貼上，按「開始查證」。",
   "in": 62.779,
   "out": 65.565
  },
  {
   "shot": "W1d",
   "who": "講解一",
   "text": "幾秒就有結果：紅燈，假訊息，信心高。",
   "in": 70.248,
   "out": 74.48
  },
  {
   "shot": "W1d",
   "who": "講解一",
   "text": "這則之前有人查過，所以馬上就有答案。",
   "in": 74.77,
   "out": 78.642
  },
  {
   "shot": "W1e",
   "who": "講解一",
   "text": "往下滑，查核來源是台灣事實查核中心的報告，點進去就能看原文。",
   "in": 79.282,
   "out": 85.601
  },
  {
   "shot": "W1f",
   "who": "講解一",
   "text": "最後按「複製連結」，傳回家族群組。",
   "in": 86.241,
   "out": 89.992
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "用了以後，十秒就知道真假，",
   "in": 96.132,
   "out": 98.656
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "還有查核機構的結論當根據。",
   "in": 98.676,
   "out": 101.23
  },
  {
   "shot": "S05",
   "who": "講解一",
   "text": "把連結傳回群組，大家看得到來源，就不用吵了。",
   "in": 101.519,
   "out": 106.136
  },
  {
   "shot": "S06",
   "who": "爸爸",
   "text": "12 期？！我上禮拜才在網路上買東西……",
   "in": 112.976,
   "out": 116.589
  },
  {
   "shot": "S06",
   "who": "爸爸",
   "text": "我現在就打給客服！",
   "in": 116.779,
   "out": 118.655
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "先暫停一下！",
   "in": 120.595,
   "out": 122.055
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "這是很常見的「解除分期」詐騙。",
   "in": 122.345,
   "out": 124.842
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "簡訊寫得很急，要你馬上打電話；",
   "in": 125.132,
   "out": 127.856
  },
  {
   "shot": "S07",
   "who": "講解二",
   "text": "接電話的假客服，會叫你去 ATM 操作，錢就被轉走了。",
   "in": 127.876,
   "out": 132.825
  },
  {
   "shot": "W2a",
   "who": "講解二",
   "text": "一樣，把整段簡訊複製，貼上，按「開始查證」。",
   "in": 133.465,
   "out": 138.068
  },
  {
   "shot": "W2b",
   "who": "講解二",
   "text": "結果是紅燈：詐騙警告，類型是網購詐騙。",
   "in": 141.263,
   "out": 145.258
  },
  {
   "shot": "W2c",
   "who": "講解二",
   "text": "判讀摘要說明，這是恐嚇式的釣魚手法。",
   "in": 145.898,
   "out": 149.526
  },
  {
   "shot": "W2d",
   "who": "講解二",
   "text": "打開「詳細說明」，它會告訴你該怎麼做：",
   "in": 150.166,
   "out": 153.445
  },
  {
   "shot": "W2d",
   "who": "講解二",
   "text": "打信用卡背面的客服電話確認，不要打簡訊裡的號碼。",
   "in": 153.465,
   "out": 157.643
  },
  {
   "shot": "W2e",
   "who": "講解二",
   "text": "下面還附上金管會、警政署的防詐資料。",
   "in": 158.283,
   "out": 162.237
  },
  {
   "shot": "S08",
   "who": "爸爸",
   "text": "好險，差點就被騙了。",
   "in": 164.038,
   "out": 166.323
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "用了以後，打電話之前就知道是詐騙，",
   "in": 167.838,
   "out": 170.933
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "也知道該打給誰。",
   "in": 170.953,
   "out": 172.429
  },
  {
   "shot": "S09",
   "who": "講解二",
   "text": "長輩自己也會用：不用帳號、不用裝 App，貼上就好。",
   "in": 172.719,
   "out": 176.854
  },
  {
   "shot": "S10",
   "who": "網友",
   "text": "留言吵成這樣，到底誰說的對啦？",
   "in": 185.194,
   "out": 188.095
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "先暫停一下！",
   "in": 190.194,
   "out": 191.578
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "在社群上看到可疑貼文，想查證得先離開 App、",
   "in": 191.868,
   "out": 196.315
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "複製、再去搜尋，很多人就懶得查了。",
   "in": 196.335,
   "out": 199.646
  },
  {
   "shot": "S11",
   "who": "講解三",
   "text": "留言區各說各話，謠言就一直傳下去。",
   "in": 199.936,
   "out": 203.383
  },
  {
   "shot": "W3a",
   "who": "講解三",
   "text": "只要在貼文底下留言，標記我們的查核機器人。",
   "in": 204.023,
   "out": 207.923
  },
  {
   "shot": "W3b",
   "who": "講解三",
   "text": "機器人每三十秒檢查一次，大約一分鐘內就會回覆。",
   "in": 208.563,
   "out": 213.156
  },
  {
   "shot": "W3c",
   "who": "講解三",
   "text": "回覆裡有燈號、摘要、MyGoPen 的查核來源，還有完整判讀的連結。",
   "in": 214.096,
   "out": 219.759
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "用了以後，不用離開 Threads，在討論的地方就能查，",
   "in": 220.499,
   "out": 224.867
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "留言區每個人都看得到結果。",
   "in": 224.887,
   "out": 226.935
  },
  {
   "shot": "S12",
   "who": "講解三",
   "text": "目前機器人還是測試版，只回覆測試人員。",
   "in": 227.225,
   "out": 231.133
  },
  {
   "shot": "W4a",
   "who": "主持人",
   "text": "最後一種情況：看起來很正常的新聞，例如市政府說要新增夜間公車。",
   "in": 233.773,
   "out": 239.974
  },
  {
   "shot": "W4b",
   "who": "主持人",
   "text": "系統查不到能確認的資料，就會老實給黃燈「無法查證」，不會硬掰。",
   "in": 242.531,
   "out": 248.338
  },
  {
   "shot": "W4b",
   "who": "主持人",
   "text": "這時候先別轉傳，等官方公告。",
   "in": 248.628,
   "out": 251.784
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "整理一下：以前要自己搜尋、靠親戚說的，",
   "in": 252.724,
   "out": 256.573
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "遇到詐騙，還差點照著簡訊打電話。",
   "in": 256.593,
   "out": 259.862
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "現在貼上就查，有查核機構的結論；",
   "in": 260.252,
   "out": 262.829
  },
  {
   "shot": "C1",
   "who": "主持人",
   "text": "在 Threads 上也能直接查，查不到也會老實說。",
   "in": 262.849,
   "out": 267.08
  },
  {
   "shot": "S13",
   "who": "全員",
   "text": "轉傳之前，先查一下！",
   "in": 268.02,
   "out": 270.455
  }
 ]
}
