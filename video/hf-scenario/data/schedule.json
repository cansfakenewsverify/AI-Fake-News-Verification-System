 "cues": [
  {
   "shot": "S02",
   "who": "A",
   "text": "欸，你看，網路上說冷水煮蛋，",
   "in": 6.24,
   "out": 8.151
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "營養會流失 40%，是真的嗎？",
   "in": 8.171,
   "out": 10.25
  },
  {
   "shot": "S02",
   "who": "B",
   "text": "真的假的，我家一直都是用冷水煮的。",
   "in": 10.54,
   "out": 13.1
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "真的喔，那我傳給我爸媽，",
   "in": 13.54,
   "out": 15.37
  },
  {
   "shot": "S02",
   "who": "A",
   "text": "叫他們以後等水滾再放蛋。",
   "in": 15.39,
   "out": 17.25
  },
  {
   "shot": "S02",
   "who": "B",
   "text": "欸，等一下，我先查一下再傳好了。",
   "in": 17.34,
   "out": 19.7
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "生活小知識最容易被轉，因為聽起來都很有道理，",
   "in": 21.84,
   "out": 25.801
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "還有「硫化亞鐵」這種專有名詞，更像真的。",
   "in": 25.821,
   "out": 29.45
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "自己上網查，各說各話；",
   "in": 29.74,
   "out": 32.026
  },
  {
   "shot": "S04",
   "who": "旁白",
   "text": "長輩又相信家人傳的，一轉就是整個群組。",
   "in": 32.046,
   "out": 36.04
  },
  {
   "shot": "W1a",
   "who": "旁白",
   "text": "先長按這則訊息，按「複製」。",
   "in": 36.78,
   "out": 39.602
  },
  {
   "shot": "W1b",
   "who": "旁白",
   "text": "打開全民查證公社的網站，不用註冊，也不用下載 App。",
   "in": 40.242,
   "out": 44.891
  },
  {
   "shot": "W1c",
   "who": "旁白",
   "text": "把訊息貼上，按「開始查證」。",
   "in": 45.431,
   "out": 47.973
  },
  {
   "shot": "W1d",
   "who": "旁白",
   "text": "幾秒就有結果：紅燈，假訊息。",
   "in": 53.043,
   "out": 56.582
  },
  {
   "shot": "W1e",
   "who": "旁白",
   "text": "判讀摘要直接告訴你：這則已經被查核過，是假訊息。",
   "in": 57.222,
   "out": 62.163
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "往下滑，有台灣事實查核中心的報告：",
   "in": 62.856,
   "out": 66.26
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "用冷水煮雞蛋，不會讓雞蛋營養價值流失。",
   "in": 66.28,
   "out": 70.117
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "報告可以點開看全文，",
   "in": 70.407,
   "out": 72.308
  },
  {
   "shot": "W1f",
   "who": "旁白",
   "text": "讓你知道判斷的根據。",
   "in": 72.328,
   "out": 74.259
  },
  {
   "shot": "W1g",
   "who": "旁白",
   "text": "最後按「複製連結」，傳回家族群組。",
   "in": 74.899,
   "out": 78.318
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "用了以後，十秒就知道真假，",
   "in": 79.058,
   "out": 81.595
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "還有查核中心的報告說明哪裡不對。",
   "in": 81.615,
   "out": 84.772
  },
  {
   "shot": "S05",
   "who": "旁白",
   "text": "把連結傳回群組，大家看得到來源，就不會再轉了。",
   "in": 85.062,
   "out": 89.667
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "查到了嗎？是真的嗎？",
   "in": 90.407,
   "out": 91.667
  },
  {
   "shot": "S03",
   "who": "B",
   "text": "是假的啦，蛋殼沒破，營養就不會流失，",
   "in": 91.907,
   "out": 94.687
  },
  {
   "shot": "S03",
   "who": "B",
   "text": "查核中心都有報告。",
   "in": 94.707,
   "out": 96.117
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "喔，冷水煮蛋沒問題，查核中心有說，",
   "in": 96.507,
   "out": 99.675
  },
  {
   "shot": "S03",
   "who": "A",
   "text": "連結給你們看。",
   "in": 99.695,
   "out": 101.018
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "欸你看，巴黎超市被洗劫，",
   "in": 103.957,
   "out": 106.092
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "只有豬肉沒有人搶耶。",
   "in": 106.112,
   "out": 107.917
  },
  {
   "shot": "S10",
   "who": "B",
   "text": "這張圖怪怪的……留言怎麼說？",
   "in": 109.307,
   "out": 111.917
  },
  {
   "shot": "S10",
   "who": "A",
   "text": "吵成一團，有人說是真的，有人說是假的。",
   "in": 113.207,
   "out": 115.717
  },
  {
   "shot": "S10",
   "who": "B",
   "text": "先別吵，查一下再說。",
   "in": 116.407,
   "out": 118.067
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "在社群上，一張 AI 做的圖配一句話，幾天就七十幾萬人看過。",
   "in": 120.307,
   "out": 126.006
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "想查證得先離開 App、複製、再去搜尋，很多人就懶得查了；",
   "in": 126.296,
   "out": 131.497
  },
  {
   "shot": "S11",
   "who": "旁白",
   "text": "留言區各說各話，說法就一直傳下去。",
   "in": 131.517,
   "out": 134.587
  },
  {
   "shot": "W2a",
   "who": "旁白",
   "text": "只要在貼文底下留言，標記我們的查核機器人。",
   "in": 135.227,
   "out": 139.022
  },
  {
   "shot": "W2b",
   "who": "旁白",
   "text": "機器人每三十秒檢查一次，大約一分鐘內就會回覆。",
   "in": 139.662,
   "out": 144.151
  },
  {
   "shot": "W2c",
   "who": "旁白",
   "text": "回覆裡有燈號、摘要、查核中心的報告，還有完整判讀的連結。",
   "in": 145.091,
   "out": 150.826
  },
  {
   "shot": "W2d",
   "who": "旁白",
   "text": "點開連結，就是網站上完整的判讀結果，查核來源一樣看得到，也可以再分享給別人。",
   "in": 151.466,
   "out": 158.647
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "用了以後，不用離開 Threads，在討論的地方就能查，",
   "in": 159.387,
   "out": 163.747
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "留言區每個人都看得到結果。",
   "in": 163.767,
   "out": 165.811
  },
  {
   "shot": "S12",
   "who": "旁白",
   "text": "目前機器人還是測試版，只回覆測試人員。",
   "in": 166.101,
   "out": 169.816
  },
  {
   "shot": "S10b",
   "who": "B",
   "text": "欸，機器人回了沒有？",
   "in": 170.506,
   "out": 171.666
  },
  {
   "shot": "S10b",
   "who": "A",
   "text": "回了，說是 AI 做的圖，",
   "in": 172.256,
   "out": 174.294
  },
  {
   "shot": "S10b",
   "who": "A",
   "text": "還附了查核中心的報告。",
   "in": 174.314,
   "out": 176.066
  },
  {
   "shot": "S10b",
   "who": "B",
   "text": "那我傳給大家看。",
   "in": 176.456,
   "out": 177.466
  },
  {
   "shot": "W4a",
   "who": "旁白",
   "text": "最後一種情況：看起來很正常的新聞，例如市政府說要新增夜間公車。",
   "in": 180.356,
   "out": 186.367
  },
  {
   "shot": "W4b",
   "who": "旁白",
   "text": "系統查不到能確認的資料，就會老實給黃燈「無法查證」，不會硬掰。",
   "in": 187.007,
   "out": 192.565
  },
  {
   "shot": "W4b",
   "who": "旁白",
   "text": "這時候先別轉傳，等官方公告。",
   "in": 192.855,
   "out": 195.861
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "整理一下：訊息和網址貼上就查，",
   "in": 196.801,
   "out": 199.14
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "在 Threads 上標記機器人也能查；",
   "in": 199.16,
   "out": 202.315
  },
  {
   "shot": "C1",
   "who": "旁白",
   "text": "每個結果都附根據，查不到也會老實說。",
   "in": 202.605,
   "out": 206.204
  },
  {
   "shot": "S13",
   "who": "旁白",
   "text": "轉傳之前，先查一下！",
