# ── AI Provider（CGU AIR Gateway，OpenAI 相容 Responses API）─────
# 教學：https://air.cgu.edu.tw/workspace4/LLMAPI/api_call.html
AI_PROVIDER=cgu
CGU_API_KEY=your_cgu_api_key_here
CGU_BASE_URL=https://air.cgu.edu.tw/cgullmapi/v1
CGU_MODEL=gpt-5.4-mini
CGU_REASONING_EFFORT=medium
# gpt-5 系列是推理模型，minimal/low 可大幅加速並省點數（minimal 會自動跳過 web_search）
OPENAI_REASONING_EFFORT=minimal
# 分析是否帶 web_search 即時佐證：true 較準但每次貴 3~7 倍，點數吃緊可設 false
USE_WEB_SEARCH=true
# AI 呼叫逾時（秒）
AI_TIMEOUT_SECONDS=60
# （P1）web_search 限定網域，逗號分隔；留空 = 不限定
WEB_SEARCH_ALLOWED_DOMAINS=

# ── 向量 embedding ───────────────────────────────────────
# 預設走 CGU AIR Gateway /embeddings；EMBED_API_KEY 空時會退用 CGU_API_KEY
EMBED_RELAY_URL=https://air.cgu.edu.tw/cgullmapi/v1
EMBED_API_KEY=your_cgu_api_key_here
EMBED_MODEL=text-embedding-3-small

# ── 已停用（保留 provider 程式供日後切回）──────────────────
# myai168 OpenAI / Claude 中繼。要切回時取消註解並設 AI_PROVIDER=openai 或 claude。
# 用 MYAI_* 命名，避免被系統內建的 OPENAI_API_KEY / ANTHROPIC_BASE_URL 覆寫
# MYAI_API_KEY=your_developer_key_here
# OPENAI_RELAY_URL=https://www.myai168.com/cgu/api/openai/v1
# OPENAI_MODEL=gpt-5-mini
# CLAUDE_RELAY_URL=https://www.myai168.com/cgu/api/anthropic/v1
# CLAUDE_MODEL=claude-opus-4-8

# ── 公開站台 / 品牌 ───────────────────────────────────────
# 對外網址（分享連結、OG、Threads 回覆用），例：https://xxx.vercel.app
PUBLIC_BASE_URL=
# 管理端點 token；留空 = 管理功能停用
ADMIN_TOKEN=
BRAND_NAME=全民查證公社
# 隱私政策 / 資料刪除頁的聯絡信箱
CONTACT_EMAIL=

# ── 模式設定 ──────────────────────────────────────────────
# true = 展示模式（回傳假資料，不呼叫 API）
# false = 正式模式（呼叫真實 AI 進行分析）
DEMO_MODE=false

# 自動抓新聞排程：true 才會背景持續查證（會持續燒點數），預設關閉
ENABLE_SCHEDULER=false
# 自動抓熱門新聞間隔（小時）
TRENDING_FETCH_INTERVAL_HOURS=6

# ── 公開上線護欄 ──────────────────────────────────────────
# 每日 AI 呼叫次數上限：達上限後，沒查過的內容回 429（已查過的仍可命中快取）。
# 一天以台灣時間 00:00 為界；計數存在資料庫，重啟不歸零。0 = 不限制。
DAILY_AI_CALL_CAP=300
# 每個 IP 的查證請求上限（每分鐘／每小時）；0 = 關閉。預設寬鬆：同一間教室對外是同一個 IP。
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=200

# ── Threads 查核機器人（延伸功能，預設關）──────────────────
# 申請：Meta 開發者後台建立 App（Threads API use case）→ 綁定機器人 Threads 帳號
# → 取得長效 access token（60 天）與 user id。四權限：threads_basic,
# threads_content_publish, threads_manage_replies, threads_manage_mentions
# 測試：venv\Scripts\python scripts\test_threads_bot.py --live
# 模式：off = 關閉；live = 真的讀 mentions 並回覆；sim = 模擬模式（不打 Threads API）
THREADS_MODE=off
# Threads App ID / Secret：取自 Meta App「Threads use case」設定頁（不是 Meta App ID）
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_BASE_URL=https://graph.threads.net/v1.0
# 輪詢間隔（分鐘）；demo 週建議 THREADS_POLL_MINUTES=1
THREADS_POLL_MINUTES=5
# 回覆上限；demo 週建議 THREADS_MAX_REPLIES_PER_POLL=2
THREADS_MAX_REPLIES_PER_POLL=5
THREADS_MAX_REPLIES_PER_DAY=50
# 機器人 Threads 帳號 handle（不含 @）
BOT_HANDLE=factcheck_tw_bot

# ── CORS（逗號分隔；正式環境 API 走 Vercel 同源代理，通常不需加網域）──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# == 雲端資料層（選用）：Supabase Postgres ==
# 預設 local = 本機檔案（Parquet + SQLite），不需要填下面兩行。
# 要上雲：Supabase 專案頁 Connect > Session pooler 複製 URI，把 [YOUR-PASSWORD] 換成資料庫密碼。
# STORAGE_BACKEND=supabase
# SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
