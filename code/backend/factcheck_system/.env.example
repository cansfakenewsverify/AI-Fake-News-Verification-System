# ── AI API Keys ──────────────────────────────────────────
# 必填：主要分析引擎 — OpenAI 相容中繼 API（學校 myai168）
OPENAI_API_KEY=your_developer_key_here
OPENAI_BASE_URL=https://www.myai168.com/cgu/api/openai/v1
OPENAI_MODEL=gpt-5

# 選填：Google Gemini API Key — 僅用於向量 embedding（中繼 API 無此端點）。
# 留空則停用語義向量快取（Layer 2），URL/Hash 快取仍正常運作。
GOOGLE_API_KEY=

# ── 模式設定 ──────────────────────────────────────────────
# true = 展示模式（回傳假資料，不呼叫 API）
# false = 正式模式（呼叫真實 AI 進行分析）
DEMO_MODE=false

# ── 資料庫（雲端部署時填入，本地開發可忽略）────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/factcheck_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=factcheck_db

# ── Redis（雲端部署時填入，本地開發可忽略）──────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Trending news search (optional) ─────────────────────
# Leave empty to use free googlesearch-python (slower, may hit rate limits)
# Get a free key at https://serper.dev (2500 free searches/month)
SERPER_API_KEY=

# How often to auto-fetch trending news (hours)
TRENDING_FETCH_INTERVAL_HOURS=6
