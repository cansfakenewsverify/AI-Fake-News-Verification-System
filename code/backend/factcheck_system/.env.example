# ── AI API Keys ──────────────────────────────────────────
# 必填：學校 myai168 中繼閘道金鑰（OpenAI 與 Claude 中繼共用同一把）
# 用 MYAI_* 命名，避免被系統內建的 OPENAI_API_KEY / ANTHROPIC_BASE_URL 覆寫
MYAI_API_KEY=your_developer_key_here

# 主分析引擎：openai(gpt-5-mini，快又省) 或 claude(品質最佳但貴約 10 倍)；另一個自動備援
AI_PROVIDER=openai
CLAUDE_RELAY_URL=https://www.myai168.com/cgu/api/anthropic/v1
CLAUDE_MODEL=claude-opus-4-8
OPENAI_RELAY_URL=https://www.myai168.com/cgu/api/openai/v1
OPENAI_MODEL=gpt-5-mini
# gpt-5 系列是推理模型，minimal/low 可大幅加速並省點數（分類任務足夠）
OPENAI_REASONING_EFFORT=minimal

# 向量 embedding：CGU LLM Gateway（OpenAI 相容，與 myai168 不同把金鑰）
EMBED_RELAY_URL=https://air.cgu.edu.tw/cgullmapi/v1
EMBED_API_KEY=your_cgu_api_key_here
EMBED_MODEL=text-embedding-3-small

# 選填：Gemini embedding 備援（CGU 失敗時才用，可留空）
GOOGLE_API_KEY=

# ── 模式設定 ──────────────────────────────────────────────
# true = 展示模式（回傳假資料，不呼叫 API）
# false = 正式模式（呼叫真實 AI 進行分析）
DEMO_MODE=false

# 省點數設定（學校點數有限，請注意）─────────────────────────
# 自動抓新聞排程：true 才會背景持續查證（會持續燒點數），預設關閉
ENABLE_SCHEDULER=false
# 分析是否帶 web_search 即時佐證：true 較準但每次貴 3~7 倍，點數吃緊可設 false
USE_WEB_SEARCH=true

# ── 資料庫（雲端部署時填入，本地開發可忽略）────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/factcheck_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=factcheck_db

# ── Redis（雲端部署時填入，本地開發可忽略）──────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Trending news search (optional) ─────────────────────
# Leave empty to use free googlesearch-python (slower, may hit rate limits)
# Get a free key at https://serper.dev (2500 free searches/month)
SERPER_API_KEY=

# How often to auto-fetch trending news (hours)
TRENDING_FETCH_INTERVAL_HOURS=6
