@startuml usecase
' ============================================================
'  使用案例圖 (Use Case Diagram)
'  全民查證公社 — AI 假訊息查證系統
' ============================================================
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  ArrowColor #1D4ED8
}

title 全民查證公社 — 使用案例圖

' ── 角色 (Actors) ──
actor "一般使用者\n(User)"      as User
actor "管理員\n(Admin)"        as Admin
actor "排程器\n(Scheduler)"     as Scheduler
actor "Gemini AI\n(外部服務)"   as Gemini
actor "RSS / 查核來源\n(外部)"   as RSS

rectangle "AI 假訊息查證系統" {
  ' ── 使用者功能 ──
  usecase "查證文字訊息"        as UC_Text
  usecase "查證網址"           as UC_Url
  usecase "查證圖片"           as UC_Image
  usecase "瀏覽今日熱門趨勢"     as UC_Trending
  usecase "查看查證結果與來源"   as UC_Result
  usecase "提交使用者回饋"       as UC_Feedback
  usecase "手動觸發新聞更新"     as UC_Refresh

  ' ── 系統 / 排程功能 ──
  usecase "自動抓取熱門新聞"     as UC_Fetch
  usecase "擷取假訊息原文並索引"  as UC_Index
  usecase "AI 分析內容"         as UC_Analyze
  usecase "三層快取比對"        as UC_Cache

  ' ── 管理員功能 ──
  usecase "人工覆寫查證結果"     as UC_Override
}

' ── 使用者關聯 ──
User --> UC_Text
User --> UC_Url
User --> UC_Image
User --> UC_Trending
User --> UC_Result
User --> UC_Feedback
User --> UC_Refresh

' ── 管理員關聯 ──
Admin --> UC_Override
Admin --> UC_Trending

' ── 排程器關聯 ──
Scheduler --> UC_Fetch
Scheduler --> UC_Refresh

' ── include / extend 關係 ──
UC_Text  ..> UC_Cache   : <<include>>
UC_Url   ..> UC_Cache   : <<include>>
UC_Image ..> UC_Cache   : <<include>>
UC_Cache ..> UC_Analyze : <<extend>>\n(快取未命中)
UC_Fetch ..> UC_Index   : <<include>>
UC_Fetch ..> UC_Analyze : <<extend>>\n(未知來源)
UC_Refresh ..> UC_Fetch : <<include>>

' ── 外部服務關聯 ──
UC_Analyze --> Gemini
UC_Index   --> Gemini
UC_Fetch   --> RSS

@enduml
