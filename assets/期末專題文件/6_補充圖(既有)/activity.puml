@startuml activity
' ============================================================
'  活動圖 (Activity Diagram)
'  自動抓取熱門新聞流程 (NewsFetcher Pipeline)
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam activity {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #F59E0B
}

title 自動抓取熱門新聞 — 活動圖（NewsFetcher 流程）

start

:排程器觸發\n(每 6 小時一次);

:抓取 RSS 來源\n(MyGoPen / TFC / Google News / Cofacts);

while (還有未處理的新聞項目？) is (有)
  :儲存／更新趨勢記錄\n(SQLite FactCheckRecord);

  :偵測來源網域\n(_detect_source);

  if (來源類型？) then (查核網站\nMISINFO)
    :標記為「已查核假訊息」\n(覆寫舊判定);
    :從標題擷取原始假訊息\n(_extract_claim_from_title);
    if (假訊息文字長度 >= 5\n且尚未索引？) then (是)
      :產生 Embedding 向量;
      :寫入知識庫 Parquet\n(MISINFO + 查核連結);
    else (否)
      :略過索引;
    endif
  elseif (官方來源\nSAFE) then
    :標記為「官方資訊」;
  else (未知來源)
    :標記為 PENDING\n(待 AI 分析);
  endif
endwhile (沒有了)

:執行待分析記錄重試\n(retry_pending_records);

while (還有 PENDING 記錄？\n上限 10 筆) is (有)
  :爬取網頁內文;
  if (內容長度 >= 50？) then (是)
    :呼叫 Gemini AI 分析;
    if (遇到限流 503/429？) then (是)
      :停止本輪\n下個週期重試;
      break
    else (否)
      :更新風險判定與摘要\n(SQLite);
    endif
  else (否)
    :略過此筆;
  endif
  :等待 2 秒（節流）;
endwhile (沒有了)

:完成本輪抓取;

stop

@enduml
