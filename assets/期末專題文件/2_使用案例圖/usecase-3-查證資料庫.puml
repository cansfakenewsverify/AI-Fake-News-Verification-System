@startuml usecase-3-knowledge
' ============================================================
'  使用案例圖（查證資料庫子系統）— 參考第五章
' ============================================================
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EFF6FF
  BorderColor #3B82F6
  ArrowColor #1D4ED8
}
title 使用案例圖（查證資料庫子系統）

actor "使用者" as User

rectangle "查證資料庫子系統" {
  usecase "瀏覽查證資料庫"   as UC_Browse
  usecase "搜尋查證資料庫"   as UC_Search
  usecase "依風險類型篩選"   as UC_Filter
  usecase "檢視資料庫統計"   as UC_Stats
  usecase "檢視快取查證"     as UC_View
}

User --> UC_Browse
User --> UC_Search
User --> UC_Filter
User --> UC_Stats

' 瀏覽/搜尋/篩選都會用到「檢視快取查證」
UC_Browse ..> UC_View : <<include>>
UC_Search ..> UC_View : <<include>>
UC_Filter ..> UC_View : <<include>>
@enduml
